desc: AuraConv Filter (Blocky Version - Optimized)

slider1:100<1,500,1>Filter Length (Taps)
slider2:0<-60,12,0.1>Output Gain (dB)
slider3:10<1,100,1>Block Width (Samples)

@init
// Memory offsets for stereo buffers
buf_l = 0;
buf_r = 1000; // Offset right channel to avoid collision with max filter length (500)

function reset_buffers() (
  memset(buf_l, 0, 500);
  memset(buf_r, 0, 500);
  buf_pos = 0;
  sum_l = 0;
  sum_r = 0;
  block_counter = 0;
  out_l = 0;
  out_r = 0;
);

reset_buffers();

@slider
// Safe parameter update logic
size != slider1 ? (
  size = slider1;
  reset_buffers(); // Prevents clicks, out-of-bounds reads, and sum corruption
);

gain = 10 ^ (slider2 / 20); // Convert dB to linear scale
block_size = slider3;

@sample
// Left Channel Moving Average
sum_l -= buf_l[buf_pos];
buf_l[buf_pos] = spl0;
sum_l += spl0;

// Right Channel Moving Average
sum_r -= buf_r[buf_pos];
buf_r[buf_pos] = spl1;
sum_r += spl1;

// Buffer index management
buf_pos += 1;
buf_pos >= size ? buf_pos = 0;

// Sample-and-Hold / Blocky update logic
block_counter += 1;
block_counter >= block_size ? (
  block_counter = 0;
  out_l = (sum_l / size) * gain;
  out_r = (sum_r / size) * gain;
);

// Assign output (Preserves Stereo)
spl0 = out_l;
spl1 = out_r;
